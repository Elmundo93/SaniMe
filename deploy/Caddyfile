# HTTPS per Let's Encrypt, sobald der A-Eintrag der Domain auf den Server zeigt.
# Domains aus /opt/sanime/env/infra.env. Keine Access-Logs: auch Pfade können
# Gesundheitsdaten verraten (Produkt-IDs, Suchbegriffe).

(sanime) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	# Das Team erreicht die Admin-App direkt unter der Domain.
	redir / /admin/ 302
}

{$DOMAIN_PROD} {
	import sanime
	reverse_proxy backend-prod:3000
}

{$DOMAIN_DEV} {
	import sanime
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy backend-dev:3000
}
