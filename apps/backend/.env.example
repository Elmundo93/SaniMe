NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://sanime:sanime@localhost:5432/sanime
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Signiert die Admin-Sitzung UND verschlüsselt die 2FA-Geheimnisse (admin-totp.ts):
# wer ihn rotiert, muss bei allen Admins die 2FA neu einrichten lassen
# (npm run backend:admin-2fa-zuruecksetzen -- <email>).
ADMIN_JWT_SECRET=change-me-in-every-environment
# Absolute Höchstdauer einer Admin-Sitzung; unabhängig davon endet sie nach 30 min Inaktivität.
ADMIN_JWT_EXPIRES_IN=8h
# Gebaute Admin-App (npm run admin:build), ausgeliefert unter /admin/. Leer = apps/admin/dist,
# "aus" = keine Auslieferung (z. B. wenn ein Reverse Proxy sie direkt ausliefert).
ADMIN_APP_DIR=
LOG_LEVEL=info

# Dev-only bootstrap admin account, read by src/db/seed/admin.seed.ts.
# Leave unset outside local dev/test — the seed script no-ops without both values.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# S3-compatible object storage — MinIO locally (see docker-compose.yml), real
# S3 in production (endpoint/credentials swap only, no code change).
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=sanime
STORAGE_SECRET_ACCESS_KEY=sanime-minio
STORAGE_BUCKET=sanime-documents
STORAGE_FORCE_PATH_STYLE=true

# HMAC key for OTP code storage (never persisted alongside the code hash) —
# see modules/verification/providers/dev-code-verification.provider.ts.
VERIFICATION_CODE_PEPPER=change-me-in-every-environment

# Stripe (checkout payment). Both optional — the app boots and every other
# feature works fine without them, only POST .../payment-intent and
# POST /webhooks/stripe fail (loudly, with a clear error) until set.
# STRIPE_SECRET_KEY: a real test-mode secret key (sk_test_...) from your own
# Stripe Dashboard — no code change needed to go live later, only swapping
# this for a live-mode key (sk_live_...).
# STRIPE_WEBHOOK_SECRET: from `stripe listen --forward-to
# localhost:3000/api/v1/webhooks/stripe` for local dev, or the Dashboard's
# webhook endpoint config for a deployed environment.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Öffentliche Katalogbilder (product_images.storage_key wird an diese Basis-URL
# gehängt). Eigener öffentlicher Bucket/CDN — NIE der Gesundheitsdokumente-Bucket
# (STORAGE_BUCKET). Leer = keine Bilder, die App zeigt Kategorie-Icon-Platzhalter.
CATALOG_IMAGE_BASE_URL=

