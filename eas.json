{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "SANIME_UMGEBUNG": "lokal" }
    },
    "testflight": {
      "distribution": "store",
      "autoIncrement": true,
      "environment": "preview",
      "env": { "SANIME_UMGEBUNG": "dev" },
      "ios": { "resourceClass": "default" }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "environment": "production",
      "env": { "SANIME_UMGEBUNG": "prod" }
    }
  },
  "submit": {
    "testflight": {},
    "production": {}
  }
}
