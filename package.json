{
  "name": "sanime",
  "version": "1.0.0",
  "workspaces": [
    "packages/@sanime/*",
    "apps/*"
  ],
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "backend:dev": "npm run start:dev --workspace apps/backend",
    "backend:build": "npm run build --workspace apps/backend",
    "backend:lint": "npm run lint --workspace apps/backend",
    "backend:typecheck": "npm run typecheck --workspace apps/backend",
    "backend:test": "npm run test --workspace apps/backend",
    "backend:test:e2e": "npm run test:e2e --workspace apps/backend",
    "backend:db:generate": "npm run db:generate --workspace apps/backend",
    "backend:db:migrate": "npm run db:migrate --workspace apps/backend",
    "backend:db:seed": "npm run db:seed --workspace apps/backend"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@stripe/stripe-react-native": "0.64.0",
    "expo": "^57.0.9",
    "expo-blur": "~57.0.3",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-manipulator": "~57.0.17",
    "expo-image-picker": "~57.0.17",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-text-extractor": "^2.0.0",
    "nativewind": "^4.1.23",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "tailwindcss": "^3.4.3",
    "typescript": "~6.0.3"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  },
  "overrides": {
    "react-dom": "19.1.0",
    "rxjs": "^7.8.2"
  }
}
